{
    "name": "bryan-parisot/local-page-generator",
    "description": "Génère des pages Elementor à partir d'un fichier CSV.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.24",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "scripts": {
        "lint": "@php bin/lint-php.php",
        "test": "phpunit",
        "test:install": "bash bin/install-wp-tests.sh wordpress_test root root 127.0.0.1 latest",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}

